# ============================================================
# Environment Variables — copy this file to .env and fill in
# your real credentials.  NEVER commit .env to version control.
# ============================================================

# Trading 212 API key (Settings → API in the T212 app)
T212_API_KEY=your_trading212_api_key_here

# OpenAI API key (only required when model.type = llm or hybrid)
OPENAI_API_KEY=your_openai_api_key_here
